# Normalize line endings so every checkout (Windows/macOS/Linux) gets LF for source and
# test files. This keeps `node --check`, editors, and readers from tripping over CRLF or
# platform-specific checkout artifacts.
*.mjs text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.sql text eol=lf
*.css text eol=lf
# Deployed to Linux (Ubuntu VM): bash rejects CRLF scripts, and `git archive` applies the
# checkout conversion (core.autocrlf) unless eol is pinned here.
*.sh  text eol=lf
*.service text eol=lf
*.example text eol=lf
