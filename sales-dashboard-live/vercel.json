{
  "functions": {
    "api/datadoe.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/in-campaign", "schedule": "30 0 * * *" },
    { "path": "/api/cron/in-asin", "schedule": "30 1 * * *" },
    { "path": "/api/cron/in-targeting", "schedule": "30 2 * * *" },
    { "path": "/api/cron/in-searchterms", "schedule": "30 3 * * *" },
    { "path": "/api/cron/americas-campaign", "schedule": "0 10 * * *" },
    { "path": "/api/cron/americas-asin", "schedule": "0 11 * * *" },
    { "path": "/api/cron/americas-targeting", "schedule": "0 12 * * *" },
    { "path": "/api/cron/americas-searchterms", "schedule": "0 13 * * *" },
    { "path": "/api/cron/au-campaign", "schedule": "0 20 * * *" },
    { "path": "/api/cron/au-asin", "schedule": "0 21 * * *" },
    { "path": "/api/cron/au-targeting", "schedule": "0 22 * * *" },
    { "path": "/api/cron/au-searchterms", "schedule": "0 23 * * *" },
    { "path": "/api/cron/other-campaign", "schedule": "0 6 * * *" },
    { "path": "/api/cron/other-asin", "schedule": "0 7 * * *" },
    { "path": "/api/cron/other-targeting", "schedule": "0 8 * * *" },
    { "path": "/api/cron/other-searchterms", "schedule": "0 9 * * *" },
    { "path": "/api/cron/sync?bucket=non-us", "schedule": "0 2 * * *" },
    { "path": "/api/cron/sync?bucket=us", "schedule": "30 10 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co" }
      ]
    }
  ]
}
