# /etc/publication-recovery/worker.env  (root:prw, mode 0640)  -- EXAMPLE ONLY, NO REAL VALUES IN GIT.
# Fill on the VM with `sudoedit /etc/publication-recovery/worker.env`. Never paste secrets into a shell history,
# a ticket, a chat, a log, or a command-line argument. systemd parses this file (no shell expansion); never `source`
# it into a shell -- run manual checks with the README's systemd-run helper instead.

# --- secrets (same values the GitHub reconcile workflows use; see README "Secrets") ---
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The route CLIs read the DataDoe ACCOUNT DIRECTORY (a zero-token GET); the worker derives the primary organization
# fingerprint from it. Nothing ever creates an export.
DATADOE_API_KEY=
# Optional (only if the secondary DataDoe organisation is configured for the dashboard):
# DATADOE_API_KEY_SECONDARY=

# --- worker behaviour (non-secret) ---
PRW_WORKER_ID=oracle-mumbai-1
# Routes this VM MAY publish (comma-separated route ids: oli, listings, fba-plan, returns-v3, ads, fba,
# brand-view-brands, sku-movement, brand-view, brand-view-portfolio). A route publishes ONLY when it is listed here AND
# public.publication_recovery_control.enabled AND its public.publication_recovery_routes row is live_enabled with the
# region in live_regions. Leave EMPTY for observe-only (tier-1 + deep sweep + status, zero publication).
# PRW_LIVE_FAMILIES is RETIRED: setting it is a configuration error.
PRW_LIVE_ROUTES=
PRW_POLL_SECONDS=20
# The tier-1 metadata consistency scan interval (must exceed the VM-measured tier-1 duration; see README memcheck).
# Keep it at 900 or more through the observe-only soak (README section 3: the production database is a small compute tier).
PRW_SCAN_INTERVAL_SECONDS=900
# Cross-pass reuse of the shared Ads digest partials while the Ads table's change probe is unchanged: the hard cap in
# seconds (0 = off). Only detection can be delayed by it, never a verification (README section 3).
PRW_SHARED_EVIDENCE_REUSE_SECONDS=3600
PRW_BATCH=5
# Must cover a live route's child sequence (3 x its hard timeout + the cleanup): 2700 covers the 840 s routes.
PRW_LEASE_SECONDS=2700
PRW_MAX_ATTEMPTS=6
PRW_MAX_CLAIMS=8
PRW_MAX_REARMS=12
PRW_CHILD_MAX_OLD_SPACE_MB=448
PRW_KEEP_DAYS=14
PRW_STOP_GRACE_SECONDS=60
# The global scheduler gate: a scheduler-owned / paid cycle updated within this window still defers every job.
PRW_SCHEDULER_COOLDOWN_SECONDS=900
# Optional extra UTC windows the scheduler owns (HH:MM-HH:MM, comma-separated, may wrap midnight). For the observe-only
# SOAK: each region's cycle incl. its downstream route jobs (india ~03:30, europe-au ~09:00, us-ca ~17:00 dispatch) and
# the evening backstops (crons 20:13 oli / 20:48 fba / 21:23 ads / 21:58 lhv3 UTC; GitHub started them 22:42-01:47 on
# 2026-09-26..29). The sync_cycles gate cannot see those jobs: inside a window a deep sweep pauses and live jobs wait
# (tier-1 is unaffected). The 18:30-20:00 gap is REQUIRED: the epoch (UTC D-1) rolls at 00:00, so us-ca's own epoch can
# only be deep-swept / repaired between its cycle and midnight. Revisit before activation (README Gate C item 6).
PRW_SCHEDULER_WINDOWS=03:00-07:30,08:30-13:00,16:30-18:30,20:00-02:30
PRW_DEEP_SWEEP_HOURS=6
PRW_AWAIT_MAX_MINUTES=120
PRW_SHADOW_PRUNE=false
# PRW_REGIONS=india,europe-au,us-ca

# --- owner activation attestations (ONLY the literal 'true' attests; see README "Attestations") ---
# FBA_PLAN_ROUTE_FENCE_ATTESTED=      # only after WP10b is deployed AND the 20260935 fence has fba-plan fenced_only=true
# SKU_MOVEMENT_SERVE_TOKEN_ATTESTED=  # only after the WP10 serve (sms2 serve token) is DEPLOYED
# LHV3_SERVE_GATE_ATTESTED=           # only while BOTH Vercel prod flags LHV3_PUBLISH_LIVE + LISTING_HEALTH_V3 are 'true'

# The operator identity recorded by the route CLIs' control packages (same as the workflows).
PRIORITY_OPERATOR=laxmikant@superboring.in
NODE_ENV=production
